# AsiSeguros — configuración para el hosting (Apache / LiteSpeed).
# GitHub Pages ignora este archivo; solo actúa en el servidor de Colombia Hosting.

# ---------- Bloqueo de sondeos automatizados ----------
# Va ANTES del bloque de HTTPS a propósito: si redirigiéramos primero, cada
# sondeo por HTTP costaría una redirección y el bot volvería a intentarlo.
# Medido en los registros del servidor: 3.436 POST contra wp-login.php y cientos
# de peticiones buscando .env, .git/config y xmlrpc. Nada de eso existe ya, pero
# redirigirlo gastaba recursos y devolvía una señal de "aquí hay algo". Con [F]
# se corta en seco, antes de llegar a PHP.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Archivos de configuración y credenciales que nunca deben servirse
  RewriteRule (^|/)\.(env|git|svn|aws|ssh|htpasswd|DS_Store) - [F,L,NC]
  RewriteRule \.(sql|bak|old|swp|sqlite|log|ini|conf)$ - [F,L,NC]
  RewriteRule (composer\.(json|lock)|package-lock\.json|yarn\.lock)$ - [F,L,NC]

  # Puntos de entrada de WordPress usados para fuerza bruta. El sitio ya no es
  # WordPress: quien los pide no es un visitante.
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-comments-post\.php) - [F,L,NC]

  # Herramientas de administración de bases de datos y shells
  RewriteRule (phpmyadmin|adminer|(^|/)(shell|vendor)/|eval\(|base64_decode) - [F,L,NC]
</IfModule>

# ---------- Métodos HTTP ----------
# El sitio solo necesita GET, POST y HEAD. Los registros muestran peticiones
# DELETE y OPTIONS que no corresponden a ningún uso legítimo.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PUT|PATCH)$
  RewriteRule .* - [F,L]
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  # Evita que el sitio se cargue dentro de un iframe ajeno (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Impide que el navegador adivine tipos de archivo
  Header always set X-Content-Type-Options "nosniff"
  # No filtrar la URL completa a sitios externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Desactiva APIs del navegador que el sitio no usa
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # Fuerza HTTPS durante un año en navegadores que ya visitaron el sitio
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # No cachear las respuestas del formulario ni del panel
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Forzar HTTPS y www ----------
# Las tres condiciones de HTTPS son deliberadas: en hostings con proxy o balanceador
# %{HTTPS} puede no llegar como "on" aunque la petición sí sea segura. Comprobando
# también las cabeceras X-Forwarded se evita un bucle de redirección infinito.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteRule ^(.*)$ https://www.asiseguros.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^asiseguros\.com$ [NC]
  RewriteRule ^(.*)$ https://www.asiseguros.com/$1 [R=301,L]

  # La entrada de asistencia legal concentra ~1.470 visitas humanas al mes
  # (medido en los registros del servidor). Mandarla a la portada desperdicia
  # esa intención: se lleva a los diferenciales, donde está la asesoría
  # jurídica. Va aquí y no como Redirect porque LiteSpeed no respeta el orden
  # de mod_alias y la regla genérica de fechas la pisaba; [L] corta el proceso.
  # Blog y taxonomías. El orden importa: la primera que coincide gana gracias a [L].
  RewriteRule ^2015/11/19/blog-asistencia-legal/?$ /asesoria-juridica.html [R=301,L]
  # El resto no tiene equivalente en el sitio nuevo. Se responde 410 y no 301 a
  # la portada: Google trata el redirect masivo al inicio como "soft 404", deja
  # la URL en el índice y sigue reportándola. El 410 dice "dejó de existir" y la
  # retira en el siguiente rastreo. El visitante humano ve la página de error,
  # que lo lleva al portafolio.
  RewriteRule ^blog/?$                    - [G,L]
  RewriteRule ^category/                  - [G,L]
  RewriteRule ^author/                    - [G,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/         - [G,L]
  RewriteRule ^wp-(admin|login|json|content|includes) - [G,L]
</IfModule>

# ---------- Redirecciones de las URLs del sitio anterior ----------
# Estaban indexadas en Google. Sin esto darían 404 y se perdería el posicionamiento.

Redirect 301 /quienes-somos/              /#nosotros
Redirect 301 /contactanos/                /#contacto
Redirect 301 /explora-nuestras-soluciones/ /#portafolio
Redirect 301 /privacy-policy/             /politica-tratamiento-datos.html

# Asistencias: ese producto no está en el sitio nuevo, van al inicio
Redirect 301 /conoce-nuestros-planes-asi/ /
Redirect 301 /asistencia-legal/           /
Redirect 301 /asistencia-medica/          /
Redirect 301 /asistencia-odontologica/    /
Redirect 301 /asistencia-vial/            /

# Tienda y productos de WooCommerce
Redirect 301 /shop/                       /
Redirect 301 /cart/                       /
Redirect 301 /checkout/                   /
Redirect 301 /my-account/                 /
Redirect 301 /product/plan-asi-x-mes/     /
Redirect 301 /product/plan-asi-x-3-meses/ /
Redirect 301 /product/plan-asi-x-ano/     /
RedirectMatch 301 ^/product-category/.*$  /

# Blog, taxonomías y restos de WordPress: ver el bloque mod_rewrite de arriba.
# No se usan RedirectMatch aquí porque en LiteSpeed mod_alias se impone sobre
# mod_rewrite, y una regla genérica pisaría a las específicas.

# ---------- Página de error ----------
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ---------- Caché del navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType text/html           "access plus 1 hour"
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ---------- Seguridad básica ----------
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
