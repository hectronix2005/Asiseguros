<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Propuesta de home unificado | AsiSeguros</title>
<meta name="robots" content="noindex, nofollow">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="../css/styles.css?v=4">
<style>
.mq-hero{padding:56px 0 90px;text-align:center}
.mq-hero h1{font-size:2.6rem;line-height:1.15;margin-bottom:14px}
.hero{min-height:0!important;height:auto!important}
.mq-hero p{max-width:640px;margin:0 auto 10px;color:#e8f0f8!important;font-size:1.1rem}
.doors{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:-56px;padding-bottom:60px;position:relative;z-index:2}
.door{background:#fff;border-radius:18px;padding:34px 30px;box-shadow:0 12px 34px rgba(10,26,48,.14);border-top:6px solid var(--accent);display:flex;flex-direction:column;gap:12px}
.door{border-top-color:var(--primary-light,#1a3a5c)}
.door i.big{color:var(--primary-light,#1a3a5c)}
.door .btn{background:var(--primary-light,#1a3a5c)!important;color:#fff!important;border-color:var(--primary-light,#1a3a5c)!important}
.door{background:#eaf2fa;text-align:center;align-items:center}
.door ul{list-style:none;margin:4px 0 8px;padding:0}
.doors .door .btn{align-self:center!important}
.doors .door i.big{color:var(--primary-light,#1a3a5c)}
.doors .door.alt i.big{color:#2a9d52}
.door.alt{background:#eafdf0;border-top-color:#7df89a}
.door.alt i.big{color:#2a9d52}
.door.alt .btn{background:#7df89a!important;border-color:#7df89a!important;color:#0a1a30!important}
.door i.big{font-size:2rem;color:var(--accent)}
.door h2{font-size:1.5rem;color:var(--primary-dark,#0a1a30)}
.door ul{margin:4px 0 8px 18px;color:#475569;line-height:1.7}
.door .btn{align-self:flex-start;margin-top:auto}
/* Corporativo: fotos con capa azul marino, tarjetas blancas, acentos menta (como el home real) */
.hero{background:linear-gradient(100deg,rgba(10,26,48,.94) 0%,rgba(15,36,65,.88) 55%,rgba(10,26,48,.78) 100%),url("../assets/img/banner2.jpg") center 30%/cover no-repeat!important}
.doors .door,.doors .door.alt{background:#fff;padding:0 28px 30px;border-top:0;overflow:hidden}
.door .photo{height:150px;margin:0 -28px 0;background-size:cover;background-position:center;align-self:stretch;width:calc(100% + 56px)}
.door .photo.p1{background-image:url("../assets/img/card-empresariales.jpg")}
.door .photo.p2{background-image:url("../assets/img/banner1.png");background-position:center 25%}
.doors .door i.big,.doors .door.alt i.big{width:70px;height:70px;line-height:70px;border-radius:50%;background:#fff;box-shadow:var(--shadow-md);margin-top:-35px;position:relative;font-size:1.7rem;color:var(--accent)}
.doors .door .btn,.doors .door.alt .btn{background:var(--secondary,#7df89a)!important;border-color:var(--secondary,#7df89a)!important;color:var(--primary-dark,#0a1a30)!important}
.door h2{color:var(--primary-dark,#0a1a30)}
.mq-sec.photo{position:relative;background:linear-gradient(rgba(10,26,48,.9),rgba(10,26,48,.9)),url("../assets/img/proceso.jpg") center/cover no-repeat}
.mq-sec.photo .section-title{color:#fff}
.mq-sec.photo .mini{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);box-shadow:none}
.mq-sec.photo .mini h3{color:#fff}
.mq-sec.photo .mini p{color:rgba(255,255,255,.75)}
.mq-sec.photo .mini i{color:var(--secondary,#7df89a)}
.mq-sec.cta{background:linear-gradient(rgba(10,26,48,.9),rgba(10,26,48,.9)),url("../assets/img/nosotros.jpg") center/cover no-repeat}
.mq-sec.cta .section-title,.mq-sec.cta p{color:#fff}
.mq-sec{padding:56px 0;text-align:center}
.mq-sec.alt{background:#f8fafc}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:26px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:26px}
.mini{background:#fff;border-radius:14px;padding:22px;box-shadow:0 4px 14px rgba(0,0,0,.07)}
.mini i{color:var(--accent);font-size:1.5rem;margin-bottom:8px}
.mini h3{font-size:1.05rem;margin-bottom:6px}
.mini p{color:#64748b;font-size:.92rem}
.tag{position:fixed;top:8px;right:8px;z-index:99;background:#f59e0b;color:#000;font:700 12px Montserrat;padding:6px 10px;border-radius:8px}
@media(max-width:800px){.doors,.grid3,.grid4{grid-template-columns:1fr}.mq-hero h1{font-size:1.8rem}}
</style></head><body>
